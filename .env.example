# --- Supabase (required) ---
# Supabase dashboard -> Project Settings -> API
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR-ANON-PUBLIC-KEY

# --- Data source (optional) ---
# "mock" (default) = deterministic generated dataset, always works
# "api"  = official Threads API (requires a token for the account you own / are authorised for)
DATA_SOURCE=mock
# Only needed when DATA_SOURCE=api. Long-lived Threads user access token (threads_basic scope).
THREADS_ACCESS_TOKEN=
# Cache window in minutes: an identical username re-analysed within this window reuses stored posts
CACHE_TTL_MINUTES=60

# --- Optional: LLM strategy recommendations (bonus) ---
# If empty, a rule-based recommendation engine is used instead.
ANTHROPIC_API_KEY=
